<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Projeto Final" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Projeto Final">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="stylesheet" href="/leaflet/leaflet.css" />
    <script src="/leaflet/leaflet.js"></script>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col min-h-screen bg-slate-50">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 bg-white border-b border-slate-200 shadow-sm z-[2000]" data-controller="navbar">

      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">

          <!-- Logo -->
          <%= link_to root_path, class: "flex items-center shrink-0", title: "Home" do %>
            <%= image_tag 'icons/home.png', alt: 'ECO', class: 'h-9 w-auto' %>
          <% end %>

          <!-- Desktop links -->
          <div class="hidden md:flex items-center gap-6">
            <%= link_to "Sobre", about_path, class: "text-sm font-medium text-slate-600 hover:text-emerald-700 transition" %>
            <%= link_to "Mapa", map_path, class: "text-sm font-medium text-slate-600 hover:text-emerald-700 transition", data: { turbo: false } %>

            <% if authenticated? %>
              <%= link_to "Chat", private_conversations_path, class: "text-sm font-medium text-slate-600 hover:text-emerald-700 transition" %>
              <%= link_to "Perfil", profile_path, class: "text-sm font-medium text-slate-600 hover:text-emerald-700 transition" %>
              <% if Current.user.moderator? %>
                <%= link_to "Moderação", moderation_dashboard_path, class: "text-sm font-medium text-slate-600 hover:text-emerald-700 transition" %>
              <% end %>
            <% end %>
          </div>

          <!-- Desktop right side -->
          <div class="hidden md:flex items-center gap-3">
            <% if authenticated? %>
              <%= user_avatar_tag Current.user, class: "h-8 w-8 rounded-full object-cover ring-2 ring-emerald-200" %>
              <span class="text-sm text-slate-600 max-w-[120px] truncate">Olá, <%= Current.user.name %></span>
              <%= button_to "Sair", session_path, method: :delete, class: "rounded-lg bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-500 transition" %>
            <% else %>
              <%= link_to "Login", new_session_path, class: "px-4 py-2 rounded-xl bg-emerald-600 text-white hover:bg-emerald-500 text-sm font-semibold transition" %>
              <%= link_to "Cadastrar", new_user_path, class: "px-4 py-2 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 text-sm font-semibold transition" %>
            <% end %>
          </div>

          <!-- Hamburger button (mobile only) -->
          <button
            type="button"
            data-action="click->navbar#toggle"
            data-navbar-target="hamburger"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition"
            aria-label="Abrir menu"
          >
            <!-- Icon: bars (closed state) -->
            <svg data-navbar-target="iconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Icon: X (open state) -->
            <svg data-navbar-target="iconClose" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

        </div>
      </div>

      <!-- Mobile menu (hidden by default) -->
      <div
        data-navbar-target="menu"
        class="hidden md:hidden border-t border-slate-200 bg-white"
      >
        <div class="container mx-auto px-4 py-3 flex flex-col gap-1">

          <% if authenticated? %>
            <!-- User info -->
            <div class="flex items-center gap-3 py-3 mb-1 border-b border-slate-100">
              <%= user_avatar_tag Current.user, class: "h-10 w-10 rounded-full object-cover ring-2 ring-emerald-200 shrink-0" %>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-800 truncate"><%= Current.user.name %></p>
                <p class="text-xs text-slate-500 truncate"><%= Current.user.email_address %></p>
              </div>
            </div>
          <% end %>

          <!-- Nav links -->
          <%= link_to "Sobre", about_path, class: "flex items-center px-3 py-2.5 rounded-lg text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition text-sm font-medium" %>

          <%= link_to "Mapa", map_path, class: "flex items-center px-3 py-2.5 rounded-lg text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition text-sm font-medium", data: { turbo: false } %>

          <% if authenticated? %>
            <%= link_to "Chat", private_conversations_path, class: "flex items-center px-3 py-2.5 rounded-lg text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition text-sm font-medium" %>

            <%= link_to "Perfil", profile_path, class: "flex items-center px-3 py-2.5 rounded-lg text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition text-sm font-medium" %>

            <% if Current.user.moderator? %>
              <%= link_to "Moderação", moderation_dashboard_path, class: "flex items-center px-3 py-2.5 rounded-lg text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition text-sm font-medium" %>
            <% end %>

            <div class="pt-2 mt-1 border-t border-slate-100">
              <%= button_to "Sair", session_path, method: :delete, class: "w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-lg text-red-600 hover:bg-red-50 transition text-sm font-medium" %>
            </div>

          <% else %>
            <div class="flex flex-col gap-2 pt-2 mt-1 border-t border-slate-100">
              <%= link_to "Login", new_session_path, class: "block text-center px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-500 transition" %>
              <%= link_to "Cadastrar", new_user_path, class: "block text-center px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition" %>
            </div>
          <% end %>

        </div>
      </div>

    </nav>

    <!-- Main Content -->
  <main class="flex-1 container mx-auto mt-24 px-5 py-8">
      <% if flash[:notice] %>
        <div class="mb-4 rounded-lg bg-green-100 border border-green-300 px-4 py-3 text-green-800 text-sm font-medium">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-4 rounded-lg bg-red-100 border border-red-300 px-4 py-3 text-red-800 text-sm font-medium">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-white text-center py-6 mt-16">
      <p class="text-sm text-slate-400">&copy; 2026 Projeto ECO. Todos os direitos reservados.</p>
    </footer>

    <!-- Chatbot Widget -->
    <div id="chatbot-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">

      <!-- Chat Window -->
      <div id="chatbot-window" class="hidden w-80 sm:w-96 bg-white rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden" style="height: 480px;">
        <!-- Header -->
        <div class="bg-emerald-600 px-4 py-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xl">🤖</span>
            <div>
              <p class="text-white font-semibold text-sm">Assistente ECO</p>
              <p class="text-green-100 text-xs">Powered by IA</p>
            </div>
          </div>
          <button onclick="toggleChatbot()" class="text-white hover:text-green-200 text-xl leading-none">&times;</button>
        </div>

        <!-- Messages -->
        <div id="chatbot-messages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50">
          <div class="flex justify-start">
            <div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2 text-sm text-slate-700 max-w-xs shadow-sm">
              Olá! 👋 Sou o assistente do ECO. Posso ajudar com dúvidas sobre a plataforma, itens disponíveis e como funciona o processo de doação. Como posso ajudar?
            </div>
          </div>
        </div>

        <!-- Input -->
        <div class="border-t border-slate-200 p-3 bg-white">
          <div class="flex gap-2">
            <input id="chatbot-input" type="text" placeholder="Digite sua pergunta..."
              class="flex-1 rounded-full border border-slate-300 px-4 py-2 text-sm outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
              onkeydown="if(event.key==='Enter') sendChatMessage()" />
            <button onclick="sendChatMessage()"
              class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500 active:bg-emerald-700">
              ➤
            </button>
          </div>
        </div>
      </div>

      <!-- Toggle Button -->
      <button onclick="toggleChatbot()"
        class="w-14 h-14 rounded-full bg-emerald-600 text-white shadow-lg hover:bg-emerald-500 active:bg-emerald-700 flex items-center justify-center text-2xl transition-transform hover:scale-110"
        title="Assistente ECO">
        🤖
      </button>
    </div>

    <script>
      function toggleChatbot() {
        var win = document.getElementById('chatbot-window');
        win.classList.toggle('hidden');
        if (!win.classList.contains('hidden')) {
          document.getElementById('chatbot-input').focus();
        }
      }

      function sendChatMessage() {
        var input = document.getElementById('chatbot-input');
        var question = input.value.trim();
        if (!question) return;

        appendMessage(question, 'user');
        input.value = '';
        appendTyping();

        fetch('<%= chatbot_ask_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').content : ''
          },
          body: JSON.stringify({ question: question })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          removeTyping();
          appendMessage(data.answer || data.error, 'bot');
        })
        .catch(function() {
          removeTyping();
          appendMessage('Erro ao conectar. Tente novamente.', 'bot');
        });
      }

      function appendMessage(text, role) {
        var container = document.getElementById('chatbot-messages');
        var div = document.createElement('div');
        div.className = 'flex ' + (role === 'user' ? 'justify-end' : 'justify-start');
        var bubble = document.createElement('div');
        bubble.className = role === 'user'
          ? 'bg-emerald-600 text-white rounded-2xl rounded-tr-sm px-4 py-2 text-sm max-w-xs shadow-sm'
          : 'bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2 text-sm text-slate-700 max-w-xs shadow-sm';
        bubble.style.whiteSpace = 'pre-wrap';
        bubble.textContent = text;
        div.appendChild(bubble);
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
      }

      function appendTyping() {
        var container = document.getElementById('chatbot-messages');
        var div = document.createElement('div');
        div.id = 'chatbot-typing';
        div.className = 'flex justify-start';
        div.innerHTML = '<div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2 text-sm text-slate-400 shadow-sm">digitando...</div>';
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
      }

      function removeTyping() {
        var el = document.getElementById('chatbot-typing');
        if (el) el.remove();
      }
    </script>
  </body>
</html>

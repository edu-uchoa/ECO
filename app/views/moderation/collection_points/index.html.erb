<div class="space-y-10">
  <div class="border-b border-slate-200 pb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">🛡️ Moderação de Pontos de Coleta</h1>
    <p class="text-sm text-slate-500 mt-1">
      Novos pins entram como <strong>pendente</strong> e só aparecem no mapa público após aprovação.
    </p>
  </div>

  <section class="space-y-4">
    <div class="flex items-center gap-3">
      <h2 class="text-lg font-semibold text-slate-800">Pendentes</h2>
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700"><%= @pending_points.size %></span>
    </div>

    <% if @pending_points.empty? %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-400">
        Nenhum ponto pendente no momento.
      </div>
    <% else %>
      <div class="space-y-4">
        <% @pending_points.each do |point| %>
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <div class="space-y-2">
                <h3 class="text-base font-semibold text-slate-800"><%= point.title %></h3>
                <p class="text-sm text-slate-600"><strong>Endereço:</strong> <%= point.address %></p>
                <p class="text-sm text-slate-600"><strong>Coordenadas:</strong> <%= point.latitude %>, <%= point.longitude %></p>
                <% if point.opening_hours.present? %>
                  <p class="text-sm text-slate-600"><strong>Horário:</strong> <%= point.opening_hours %></p>
                <% end %>
                <% if point.description.present? %>
                  <p class="text-sm text-slate-700"><%= point.description %></p>
                <% end %>
                <p class="text-xs text-slate-400">Enviado por <%= point.user.name %> em <%= l(point.created_at, format: :short) %></p>
                <% if point.categories.present? %>
                  <div class="flex flex-wrap gap-2 pt-1">
                    <% point.categories.each do |category| %>
                      <span class="rounded-full bg-emerald-100 text-emerald-700 text-xs px-3 py-1"><%= category %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="flex flex-col gap-2 min-w-[220px]">
                <%= button_to "✅ Aprovar",
                      approve_moderation_collection_point_path(point),
                      method: :patch,
                      class: "w-full rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-500 transition" %>

                <%= form_with url: reject_moderation_collection_point_path(point), method: :patch, class: "space-y-2" do |f| %>
                  <%= f.text_area :rejection_reason,
                        rows: 3,
                        placeholder: "Motivo da rejeição (obrigatório)",
                        class: "w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none resize-none" %>
                  <%= f.submit "❌ Rejeitar",
                        class: "w-full rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-500 transition cursor-pointer" %>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-slate-800">Moderados Recentemente</h2>

    <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Título</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Status</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Atualizado em</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Motivo rejeição</th>
          </tr>
        </thead>
        <tbody>
          <% @recently_moderated.each do |point| %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-3 text-slate-800"><%= point.title %></td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= point.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                  <%= point.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-500"><%= l(point.updated_at, format: :short) %></td>
              <td class="px-4 py-3 text-slate-500"><%= point.rejection_reason.presence || '-' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-slate-800">🧾 Logs de Moderação (Auditoria)</h2>

    <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Data/Hora</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Moderador</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Item</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Ação</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">De → Para</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wide">Motivo</th>
          </tr>
        </thead>
        <tbody>
          <% @moderation_logs.each do |log| %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-3 text-slate-500"><%= l(log.created_at, format: :short) %></td>
              <td class="px-4 py-3 text-slate-800"><%= log.moderator.name %></td>
              <td class="px-4 py-3 text-slate-800"><%= log.collection_point.title %></td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= log.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                  <%= log.action_type %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-500"><%= [log.previous_status, log.new_status].join(" → ") %></td>
              <td class="px-4 py-3 text-slate-500"><%= log.reason.presence || '-' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

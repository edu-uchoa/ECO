
<div class="mx-auto max-w-md w-full">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Criar conta</h1>
      <p class="mt-1 text-sm text-slate-500">Junte-se ao Projeto ECO e comece a doar.</p>
    </div>

    <% if defined?(@user) && @user.respond_to?(:errors) && @user.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-200 p-4">
        <p class="font-semibold text-red-700 text-sm">Por favor corrija os erros abaixo:</p>
        <ul class="list-disc list-inside mt-2 text-sm text-red-600">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: (@user || User.new), local: true, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, "Nome de usuário", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name, required: true, autocomplete: "username", placeholder: "Escolha um nome único",
              class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
        <% if @user&.errors[:name].present? %>
          <p class="text-red-500 text-xs mt-1"><%= @user.errors.full_messages_for(:name).join(', ') %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :email_address, "E-mail", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "seu@email.com",
              class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none", inputmode: "email" %>
        <% if @user&.errors[:email_address].present? %>
          <p class="text-red-500 text-xs mt-1"><%= @user.errors.full_messages_for(:email_address).join(', ') %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password, "Senha", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", minlength: 6, maxlength: 72,
              class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
        <% if @user&.errors[:password].present? %>
          <p class="text-red-500 text-xs mt-1"><%= @user.errors.full_messages_for(:password).join(', ') %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repita a senha", minlength: 6, maxlength: 72,
              class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
        <% if @user&.errors[:password_confirmation].present? %>
          <p class="text-red-500 text-xs mt-1"><%= @user.errors.full_messages_for(:password_confirmation).join(', ') %></p>
        <% end %>
      </div>

      <%= form.submit "Criar conta", class: "w-full rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-500 transition cursor-pointer" %>

      <p class="text-center text-sm text-slate-500">
        Já tem conta?
        <%= link_to "Entrar", new_session_path, class: "text-emerald-600 font-medium hover:underline" %>
      </p>
    <% end %>
  </div>
</div>


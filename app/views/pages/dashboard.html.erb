<%# ── Dashboard ─────────────────────────────────────────────── %>
<div class="space-y-10">

  <%# ── Header ── %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Dashboard</h1>
      <p class="mt-1 text-sm text-slate-500">Olá, <span class="font-medium text-slate-700"><%= Current.user.name %></span> — gerencie e explore itens para doação.</p>
    </div>
    <%= link_to new_post_path,
          class: "inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 active:bg-emerald-700 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      Adicionar Item
    <% end %>
  </div>

  <%# ── Itens disponíveis ── %>
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Itens Disponíveis para Doação</h2>
        <% all_posts = Post.available.recent.where.not(user_id: Current.user.id) %>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
          <%= all_posts.count %>
        </span>
      </div>
      <%= link_to "Ver todos →", posts_path, class: "text-sm font-medium text-emerald-600 hover:text-emerald-500 transition" %>
    </div>

    <% if all_posts.any? %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% all_posts.limit(6).each do |post| %>
          <div class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
            <% if post.images.attached? %>
              <div class="h-44 overflow-hidden bg-slate-100">
                <%= image_tag post.main_image, alt: post.title, class: "h-full w-full object-cover transition group-hover:scale-105 duration-300" %>
              </div>
            <% else %>
              <div class="h-44 bg-slate-100 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            <% end %>

            <div class="flex flex-1 flex-col p-4 gap-3">
              <div>
                <h3 class="font-semibold text-slate-900 leading-snug"><%= post.title %></h3>
                <p class="text-xs text-slate-400">
                  Por <%= link_to post.user.name, user_path(post.user), class: "font-medium text-emerald-600 hover:underline" %>
                </p>
                <p class="mt-1 line-clamp-2 text-xs text-slate-500"><%= post.description %></p>
              </div>

              <div class="flex flex-wrap gap-1.5">
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= post.category %></span>
                <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700"><%= post.condition %></span>
              </div>

              <p class="text-xs text-slate-400">📍 <%= post.location %></p>

              <%= link_to "Ver Detalhes", post_path(post),
                    class: "mt-auto block rounded-xl bg-slate-900 px-4 py-2 text-center text-xs font-semibold text-white hover:bg-slate-700 transition" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border-2 border-dashed border-slate-200 p-14 text-center">
        <p class="text-sm text-slate-400">Nenhum item disponível no momento.</p>
        <%= link_to "Seja o primeiro a adicionar →", new_post_path,
              class: "mt-3 inline-block text-sm font-medium text-emerald-600 hover:underline" %>
      </div>
    <% end %>
  </section>

  <%# ── Meus Posts ── %>
  <% if Current.user.posts.available.any? %>
    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Meus Itens</h2>
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
          <%= Current.user.posts.available.count %>
        </span>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% Current.user.posts.available.recent.each do |post| %>
          <div class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
            <% if post.images.attached? %>
              <div class="h-44 overflow-hidden bg-slate-100">
                <%= image_tag post.main_image, alt: post.title, class: "h-full w-full object-cover transition group-hover:scale-105 duration-300" %>
              </div>
            <% else %>
              <div class="h-44 bg-slate-100 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            <% end %>

            <div class="flex flex-1 flex-col p-4 gap-3">
              <div>
                <h3 class="font-semibold text-slate-900 leading-snug"><%= post.title %></h3>
                <p class="mt-1 line-clamp-2 text-xs text-slate-500"><%= post.description %></p>
              </div>

              <div class="flex flex-wrap gap-1.5">
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= post.category %></span>
                <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700"><%= post.condition %></span>
              </div>

              <p class="text-xs text-slate-400">📍 <%= post.location %></p>

              <div class="mt-auto flex gap-2 pt-1">
                <%= link_to "Ver", post_path(post),
                      class: "flex-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-xs font-semibold text-slate-700 hover:bg-slate-50 transition" %>
                <%= link_to "Editar", edit_post_path(post),
                      class: "flex-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-xs font-semibold text-slate-700 hover:bg-slate-50 transition" %>
                <%= button_to "Remover", post_path(post), method: :delete,
                      data: { confirm: "Tem certeza que deseja remover este item?" },
                      class: "flex-1 rounded-lg bg-red-50 px-2 py-1.5 text-center text-xs font-semibold text-red-600 hover:bg-red-100 transition" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

</div>
<div class="mx-auto max-w-md w-full">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-800">Recuperar senha</h1>
      <p class="mt-1 text-sm text-slate-500">Enviaremos um link de redefinição para seu e-mail.</p>
    </div>

    <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "E-mail", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "seu@email.com", value: params[:email_address],
              class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
      </div>

      <%= form.submit "Enviar instruções", class: "w-full rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-500 transition cursor-pointer" %>

      <p class="text-center text-sm">
        <%= link_to "← Voltar ao login", new_session_path, class: "text-slate-600 hover:underline" %>
      </p>
    <% end %>
  </div>
</div>

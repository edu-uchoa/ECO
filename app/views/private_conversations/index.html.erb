<div class="mx-auto max-w-2xl space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200 pb-5">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">Minhas Conversas</h1>
    <%= link_to "← Dashboard", dashboard_path, class: "text-sm font-medium text-slate-500 hover:text-slate-800 transition" %>
  </div>

  <% if @conversations.any? %>
    <div class="space-y-2">
      <% @conversations.each do |conversation| %>
        <% other = conversation.other_user(Current.user) %>
        <%= link_to private_conversation_path(conversation), class: "block rounded-2xl border border-slate-200 bg-white p-4 hover:shadow-md hover:border-slate-300 transition" do %>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-slate-900"><%= other.name %></p>
              <% if conversation.messages.any? %>
                <p class="text-sm text-slate-400 mt-0.5 line-clamp-1"><%= conversation.messages.last.content %></p>
              <% else %>
                <p class="text-sm text-slate-300 mt-0.5 italic">Nenhuma mensagem ainda</p>
              <% end %>
            </div>
            <% if conversation.messages.any? %>
              <span class="text-xs text-slate-400 shrink-0 ml-4"><%= time_ago_in_words(conversation.messages.last.created_at) %> atrás</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 p-10 text-center">
      <p class="text-sm text-slate-400">Você ainda não tem conversas.</p>
      <p class="text-xs text-slate-300 mt-1">Visite o perfil de um usuário para iniciar um chat.</p>
    </div>
  <% end %>
</div>


<div class="mx-auto max-w-lg space-y-8">
  <div class="border-b border-slate-200 pb-5">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">Editar Perfil</h1>
    <p class="mt-1 text-sm text-slate-500">Mantenha seus dados atualizados.</p>
  </div>

  <%= form_with model: @user, url: profile_path, method: :patch, local: true, multipart: true, class: "space-y-6" do |form| %>
    
    <% if @user.errors.any? %>
      <div id="error_explanation" class="rounded-xl bg-red-50 border border-red-200 p-4">
        <h2 class="font-semibold text-red-700 text-sm">
          <%= pluralize(@user.errors.count, "erro") %> ao atualizar perfil:
        </h2>
        <ul class="mt-2 list-inside space-y-1 text-xs text-red-600">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ── Avatar ── %>
    <div class="flex items-center gap-5">
      <div id="avatar-preview-wrap" class="h-20 w-20 rounded-full overflow-hidden ring-2 ring-slate-200 bg-slate-100 flex items-center justify-center shrink-0">
        <% if @user.avatar.attached? %>
          <img id="avatar-preview" src="<%= url_for(@user.avatar) %>" class="h-full w-full object-cover" alt="Avatar">
        <% else %>
          <img id="avatar-preview" src="<%= asset_path('default_avatar.svg') %>" class="h-full w-full object-cover" alt="Avatar">
        <% end %>
      </div>
      <div class="flex-1 space-y-2">
        <%= form.label :avatar, "Foto de Perfil", class: "block text-sm font-medium text-slate-700" %>
        <%= form.file_field :avatar, accept: "image/*", class: "block w-full text-sm text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer", id: "avatar-input" %>
        <p class="text-xs text-slate-400">PNG, JPG, GIF ou WEBP · máx. 5MB</p>
        <% if @user.avatar.attached? %>
          <label class="flex items-center gap-1.5 text-xs text-red-500 cursor-pointer">
            <%= form.check_box :remove_avatar, { class: "rounded border-slate-300 text-red-500 focus:ring-red-400" }, "1", "0" %>
            Remover foto atual
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <%= form.label :name, "Nome", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email_address, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4">
      <h3 class="font-semibold text-emerald-900 text-sm">Informações Pessoais</h3>
      <p class="mt-1 text-xs text-emerald-700">Estes campos são obrigatórios para criar posts</p>
    </div>

    <div>
      <%= form.label :cpf, "CPF", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :cpf, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none", placeholder: "Apenas números" %>
    </div>

    <div>
      <%= form.label :telefone, "Telefone", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :telefone, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none", placeholder: "Apenas números" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :uf, "UF", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :uf, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none", placeholder: "Ex: DF", maxlength: 2 %>
      </div>
      <div>
        <%= form.label :cidade, "Cidade", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :cidade, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none", placeholder: "Ex: Brasília" %>
      </div>
    </div>

    <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
      <h3 class="font-semibold text-slate-800 text-sm">Alteração de Senha</h3>
      <p class="mt-1 text-xs text-slate-500">Deixe os campos vazios se não quiser alterar a senha</p>
    </div>

    <div>
      <%= form.label :password, "Nova Senha", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirme a nova senha", class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <div class="rounded-xl bg-amber-50 border border-amber-200 p-4">
      <p class="text-xs text-amber-800">
        <strong>⚠️ Aviso:</strong> Se alterar a senha, você será desconectado automaticamente.
      </p>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Salvar Alterações", class: "rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 transition cursor-pointer" %>
      <%= link_to "Cancelar", profile_path, class: "rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" %>
    </div>
  <% end %>

<script>
  document.getElementById('avatar-input').addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      alert('A imagem deve ter menos de 5MB.');
      e.target.value = '';
      return;
    }
    var reader = new FileReader();
    reader.onload = function(ev) {
      document.getElementById('avatar-preview').src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });
</script>

  <hr class="border-slate-200">

  <div class="space-y-4">
    <h2 class="text-base font-bold text-red-600">Zona de Perigo</h2>
    <p class="text-sm text-slate-500">A exclusão da conta é permanente e não pode ser desfeita.</p>
    <%= button_to "Excluir Minha Conta", profile_path, method: :delete,
        form: { data: { turbo_confirm: "Tem certeza que deseja excluir sua conta? Esta ação é irreversível!" } },
        class: "rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition" %>
  </div>
</div>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
  <div class="space-y-10 lg:col-span-2">
    <%# Itens disponíveis %>
    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Meus Itens Disponíveis</h2>
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700"><%= @available_posts.count %></span>
      </div>

      <% if @available_posts.any? %>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @available_posts.each do |post| %>
            <div class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition">
              <% if post.images.attached? %>
                <div class="h-44 overflow-hidden bg-slate-100">
                  <%= image_tag post.main_image, alt: post.title, class: "h-full w-full object-cover transition group-hover:scale-105 duration-300" %>
                </div>
              <% else %>
                <div class="h-44 bg-slate-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
              <% end %>

              <div class="flex flex-1 flex-col p-4 gap-3">
                <h3 class="font-semibold text-slate-900"><%= post.title %></h3>
                <p class="line-clamp-2 text-xs text-slate-500"><%= post.description %></p>

                <div class="flex flex-wrap gap-1.5">
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= post.category %></span>
                  <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700"><%= post.condition %></span>
                </div>

                <p class="text-xs text-slate-400">📍 <%= post.location %></p>

                <div class="mt-auto flex gap-2 pt-1">
                  <%= link_to "Ver", post_path(post), class: "flex-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-xs font-semibold text-slate-700 hover:bg-slate-50 transition" %>
                  <%= link_to "Editar", edit_post_path(post), class: "flex-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-xs font-semibold text-slate-700 hover:bg-slate-50 transition" %>
                  <%= button_to "Remover", post_path(post), method: :delete, data: { confirm: "Tem certeza?" }, class: "flex-1 rounded-lg bg-red-50 px-2 py-1.5 text-center text-xs font-semibold text-red-600 hover:bg-red-100 transition" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border-2 border-dashed border-slate-200 p-8 text-center">
          <p class="text-sm text-slate-400">Você não tem itens disponíveis no momento.</p>
          <%= link_to "Adicionar Item", new_post_path, class: "mt-3 inline-block rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500 transition" %>
        </div>
      <% end %>
    </section>

    <%# Itens já doados %>
    <% if @taken_posts.any? %>
      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-semibold text-slate-800">Itens Já Doados</h2>
          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500"><%= @taken_posts.count %></span>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @taken_posts.each do |post| %>
            <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm opacity-70">
              <% if post.images.attached? %>
                <div class="h-44 overflow-hidden bg-slate-100">
                  <%= image_tag post.main_image, alt: post.title, class: "h-full w-full object-cover grayscale" %>
                </div>
              <% else %>
                <div class="h-44 bg-slate-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
              <% end %>

              <div class="flex flex-1 flex-col p-4 gap-3">
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-slate-500"><%= post.title %></h3>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-400">Doado</span>
                </div>
                <p class="line-clamp-2 text-xs text-slate-400"><%= post.description %></p>
                <div class="flex flex-wrap gap-1.5">
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-400"><%= post.category %></span>
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-400"><%= post.condition %></span>
                </div>
                <p class="text-xs text-slate-400">📍 <%= post.location %></p>

                <% if post.review.present? %>
                  <div class="rounded-xl bg-amber-50 border border-amber-200 px-3 py-2 space-y-1">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-1">
                        <% 5.times do |i| %>
                          <span class="text-sm <%= i < post.review.rating ? 'text-amber-400' : 'text-slate-300' %>">★</span>
                        <% end %>
                        <span class="text-xs text-slate-500 ml-1">por <%= post.review.user.name %></span>
                      </div>
                      <%= button_to "🗑", post_review_path(post), method: :delete,
                          data: { confirm: "Remover esta avaliação?" },
                          class: "rounded bg-red-50 px-1.5 py-0.5 text-xs text-red-600 hover:bg-red-100 transition" %>
                    </div>
                    <p class="text-xs text-slate-600 line-clamp-2"><%= post.review.comment %></p>
                  </div>
                <% else %>
                  <p class="text-xs text-slate-400 italic">Sem avaliação ainda.</p>
                <% end %>

                <div class="mt-auto flex gap-2 pt-1">
                  <%= link_to "Ver Detalhes", post_path(post), class: "flex-1 rounded-xl bg-slate-900 px-4 py-2 text-center text-xs font-semibold text-white hover:bg-slate-700 transition" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <aside class="lg:col-span-1">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:sticky lg:top-28">
      <h2 class="text-lg font-bold text-slate-800">Meu Perfil</h2>

      <%# Avatar %>
      <div class="mt-4 flex justify-center">
        <div class="h-24 w-24 rounded-full overflow-hidden ring-4 ring-emerald-100 bg-slate-100">
          <%= user_avatar_tag @user, class: "h-full w-full object-cover" %>
        </div>
      </div>

      <div class="mt-5 space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide">Nome</label>
          <div class="mt-1 text-sm font-medium text-slate-900"><%= @user.name %></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide">Email</label>
          <div class="mt-1 text-sm font-medium text-slate-900"><%= @user.email_address %></div>
        </div>
      </div>

      <div class="mt-6">
        <%= link_to "Editar Perfil", edit_profile_path, class: "block w-full rounded-xl bg-emerald-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-emerald-500 transition" %>
      </div>
    </div>
  </aside>
</div>

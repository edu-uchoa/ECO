<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">Itens para Doação</h1>
  </div>

  <div class="flex flex-col gap-3 md:flex-row">
    <%= form_with url: posts_path, method: :get, local: true, class: "flex flex-col gap-2 md:flex-row w-full" do |f| %>
      <div class="flex-1">
        <%= f.select :category, options_for_select([""] + Post::CATEGORIES, params[:category]), { prompt: "Todas as categorias" },
              class: "w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
      </div>
      <div class="flex-1">
        <%= f.text_field :location, placeholder: "Filtrar por localização", value: params[:location],
              class: "w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Filtrar", class: "rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-500 transition cursor-pointer" %>
        <%= link_to "Limpar", posts_path, class: "rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" %>
      </div>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @posts.each do |post| %>
        <div class="group flex flex-col overflow-hidden rounded-2xl border <%= post.status == 'taken' ? 'border-slate-200 opacity-75' : 'border-slate-200' %> bg-white shadow-sm hover:shadow-md transition relative">
          <% if post.status == "taken" %>
            <div class="absolute top-2 left-2 z-10 rounded-full bg-slate-700 px-3 py-1 text-xs font-bold text-white shadow">
              🔒 Doado
            </div>
          <% else %>
            <div class="absolute top-2 left-2 z-10 rounded-full bg-emerald-600 px-3 py-1 text-xs font-bold text-white shadow">
              ✅ Disponível
            </div>
          <% end %>
          <% if post.images.attached? %>
            <div class="h-48 overflow-hidden bg-slate-100">
              <%= image_tag post.main_image, alt: post.title, class: ["h-full w-full object-cover transition group-hover:scale-105 duration-300", post.status == "taken" ? "grayscale" : nil].compact.join(" ") %>
            </div>
          <% else %>
            <div class="h-48 bg-slate-100 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
          <% end %>

          <div class="flex flex-1 flex-col p-4 gap-3">
            <div>
              <h3 class="font-semibold text-slate-900"><%= post.title %></h3>
              <%= link_to post.user.name, user_path(post.user), class: "text-xs text-emerald-600 font-medium hover:underline" %>
            </div>
            <p class="line-clamp-2 text-xs text-slate-500"><%= post.description %></p>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= post.category %></span>
              <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700"><%= post.condition %></span>
            </div>
            <p class="text-xs text-slate-400">📍 <%= post.location %></p>
            <%= link_to "Ver Detalhes", post_path(post), class: "mt-auto block rounded-xl bg-slate-900 px-4 py-2 text-center text-xs font-semibold text-white hover:bg-slate-700 transition" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 p-12 text-center">
      <p class="text-sm text-slate-400">Nenhum item encontrado</p>
    </div>
  <% end %>
</div>

<div class="mx-auto max-w-2xl space-y-8">
  <div class="border-b border-slate-200 pb-5">
    <h1 class="text-2xl font-bold tracking-tight text-slate-800">Editar Item</h1>
    <p class="mt-1 text-sm text-slate-500">Atualize as informações do seu item.</p>
  </div>

  <%= form_with(model: @post, local: true, class: "space-y-6") do |form| %>
    <% if @post.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-200 p-4">
        <h2 class="text-red-700 font-semibold text-sm"><%= pluralize(@post.errors.count, "erro") %> encontrado:</h2>
        <ul class="mt-2 list-disc list-inside text-xs text-red-600">
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, "Título do Item", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :title, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <div>
      <%= form.label :description, "Descrição", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_area :description, rows: 5, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none resize-none" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :category, "Categoria", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :category, Post::CATEGORIES, {}, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
      </div>
      <div>
        <%= form.label :condition, "Condição de Uso", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :condition, Post::CONDITIONS, {}, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
      </div>
    </div>

    <div>
      <%= form.label :location, "Localização", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :location, class: "mt-1 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none" %>
    </div>

    <% if @post.images.attached? %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2">Fotos Atuais</label>
        <p class="text-xs text-slate-400 mb-3">Clique em uma foto para definir como <strong class="text-slate-600">★ foto principal</strong>. Para substituir todas, use o campo abaixo.</p>
        <%= form.hidden_field :main_image_index, value: @post.main_image_index, id: "main_image_index_existing" %>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <% @post.images.each_with_index do |image, i| %>
            <div class="relative aspect-square rounded-2xl overflow-hidden cursor-pointer border-2 transition existing-img-slot
                        <%= i == (@post.main_image_index || 0) ? 'border-emerald-500 ring-2 ring-emerald-400' : 'border-slate-200' %>"
                 onclick="setExistingMain(<%= i %>)">
              <%= image_tag image, alt: "foto #{i+1}", class: "h-full w-full object-cover" %>
              <div id="main-badge-<%= i %>" class="<%= i == (@post.main_image_index || 0) ? '' : 'hidden' %> absolute top-1.5 left-1.5 rounded-full bg-emerald-500 px-2 py-0.5 text-xs font-bold text-white shadow">★ Principal</div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div>
      <%= form.label :images, "Substituir todas as fotos (até 4 imagens)", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <p class="text-xs text-slate-400 mb-3">Selecionar novas fotos <strong>substituirá</strong> todas as fotos existentes. Clique em uma para definir como principal.</p>

      <%= form.hidden_field :main_image_index, value: 0, id: "main_image_index_new" %>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% 4.times do |i| %>
          <div id="edit-slot-<%= i %>"
               class="relative aspect-square rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 overflow-hidden cursor-pointer hover:border-emerald-400 transition"
               onclick="editSlotClick(<%= i %>)">
            <input type="file" id="edit-slot-input-<%= i %>" accept="image/*"
                   class="hidden" onchange="editSlotChange(<%= i %>, this)" />
            <div id="edit-slot-empty-<%= i %>" class="absolute inset-0 flex flex-col items-center justify-center gap-1 text-slate-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
              </svg>
              <span class="text-xs"><%= i == 0 ? "Principal" : "Foto #{i + 1}" %></span>
            </div>
            <img id="edit-slot-img-<%= i %>" src="" alt="" class="absolute inset-0 h-full w-full object-cover hidden" />
            <div id="edit-slot-badge-<%= i %>" class="hidden absolute top-1.5 left-1.5 rounded-full bg-emerald-500 px-2 py-0.5 text-xs font-bold text-white shadow">★ Principal</div>
            <button type="button" id="edit-slot-remove-<%= i %>"
                    class="hidden absolute top-1 right-1 rounded-full bg-red-500 p-0.5 text-white hover:bg-red-600 transition z-10"
                    onclick="event.stopPropagation(); editSlotRemove(<%= i %>)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% end %>
      </div>

      <%= form.file_field :images, multiple: true, accept: "image/*", class: "hidden", id: "edit-images-submit-input" %>
      <p class="mt-2 text-xs text-slate-400">PNG, JPG ou WEBP até 5MB cada. Deixe em branco para manter as fotos atuais.</p>
    </div>

    <script>
      // --- Existing images: pick main ---
      function setExistingMain(i) {
        document.getElementById('main_image_index_existing').value = i;
        document.querySelectorAll('.existing-img-slot').forEach(function(el, idx) {
          var badge = document.getElementById('main-badge-' + idx);
          if (idx === i) {
            el.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-400');
            el.classList.remove('border-slate-200');
            badge.classList.remove('hidden');
          } else {
            el.classList.remove('border-emerald-500', 'ring-2', 'ring-emerald-400');
            el.classList.add('border-slate-200');
            badge.classList.add('hidden');
          }
        });
      }

      // --- New images: per-slot approach ---
      var _editSlotFiles = [null, null, null, null];
      var _editMainIndex = 0;

      function editSlotClick(i) {
        if (_editSlotFiles[i]) {
          _editMainIndex = i;
          document.getElementById('main_image_index_new').value = i;
          _editRenderAll();
        } else {
          document.getElementById('edit-slot-input-' + i).click();
        }
      }

      function editSlotChange(i, input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
          alert('❌ "' + file.name + '" excede 5MB. Escolha uma imagem menor.');
          input.value = '';
          return;
        }
        _editSlotFiles[i] = file;
        var hasMain = _editSlotFiles[_editMainIndex] !== null;
        if (!hasMain) { _editMainIndex = i; }
        _editRenderSlot(i);
        _editSync();
      }

      function editSlotRemove(i) {
        _editSlotFiles[i] = null;
        if (_editMainIndex === i) {
          var next = _editSlotFiles.findIndex(function(f) { return f !== null; });
          _editMainIndex = next >= 0 ? next : 0;
        }
        _editRenderSlot(i);
        _editSync();
      }

      function _editRenderSlot(i) {
        var slot  = document.getElementById('edit-slot-' + i);
        var img   = document.getElementById('edit-slot-img-' + i);
        var badge = document.getElementById('edit-slot-badge-' + i);
        var rem   = document.getElementById('edit-slot-remove-' + i);
        var empty = document.getElementById('edit-slot-empty-' + i);
        var f = _editSlotFiles[i];
        if (f) {
          img.src = URL.createObjectURL(f);
          img.classList.remove('hidden');
          empty.classList.add('hidden');
          rem.classList.remove('hidden');
        } else {
          img.src = ''; img.classList.add('hidden');
          empty.classList.remove('hidden'); rem.classList.add('hidden');
        }
        var isMain = (i === _editMainIndex) && f;
        if (isMain) {
          badge.classList.remove('hidden');
          slot.classList.add('ring-2', 'ring-emerald-500', 'border-emerald-400');
          slot.classList.remove('border-slate-200', 'border-dashed');
        } else {
          badge.classList.add('hidden');
          slot.classList.remove('ring-2', 'ring-emerald-500', 'border-emerald-400');
          slot.classList.add('border-slate-200', 'border-dashed');
        }
      }

      function _editRenderAll() { for (var i = 0; i < 4; i++) { _editRenderSlot(i); } }

      function _editSync() {
        var dt = new DataTransfer();
        _editSlotFiles.forEach(function(f) { if (f) dt.items.add(f); });
        document.getElementById('edit-images-submit-input').files = dt.files;
        var nonNull = _editSlotFiles.filter(function(f) { return f !== null; });
        var mainFile = _editSlotFiles[_editMainIndex];
        var idx = nonNull.indexOf(mainFile);
        document.getElementById('main_image_index_new').value = idx >= 0 ? idx : 0;
        // Disable existing main index field when new images are chosen
        var existingField = document.getElementById('main_image_index_existing');
        if (existingField) existingField.disabled = nonNull.length > 0;
      }
    </script>

    <div class="flex gap-3">
      <%= form.submit "Salvar Alterações", class: "rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 transition cursor-pointer" %>
      <%= link_to "Cancelar", @post, class: "rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" %>
    </div>
  <% end %>
</div>
